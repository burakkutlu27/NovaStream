{
  "manifest_version": 3,
  "name": "NovaStream Video Downloader",
  "version": "2.7.0",
  "description": "Herhangi bir sekme açmadan arka planda HLS ve MP4 videoları doğrudan İndirilenler klasörüne kaydeden limitsiz medya indirici.",
  "browser_specific_settings": {
    "gecko": {
      "id": "novastream@downloader.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "notifications",
    "nativeMessaging",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "NovaStream"
  }
}
